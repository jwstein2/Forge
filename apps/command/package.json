{
  "name": "@forge/command",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FORGE Command: executive dashboard for the FORGE portfolio (frontend only).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "screenshots": "playwright test e2e/screenshots.spec.ts --trace off"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource-variable/newsreader": "5.2.6",
    "@fontsource/ibm-plex-mono": "5.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
